# Copy to .env and fill in. Generate a key with `go run . key:generate`.
APP_ENV=local
APP_DEBUG=true
APP_KEY=

# Where the sqlite database lives, relative to the application root.
DB_DATABASE=storage/database.sqlite

# Local development is served over plain http, where a Secure cookie is
# never sent. Do not carry this into a deployment.
SESSION_SECURE=false
