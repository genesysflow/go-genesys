package policies

import (
	"github.com/genesysflow/go-genesys/auth"
)

// {{.Name}} authorizes actions on its model. Each method is an ability:
// Update answers "update", ViewAny answers "view-any".
//
// Register it once at boot, then ask the gate:
//
//	auth.RegisterPolicy[models.Model](gate, &policies.{{.Name}}{})
//	ctx.Authorize("update", model)
type {{.Name}} struct{}

// model is a placeholder: point the policy at your own model type.
type model struct{ OwnerID int64 }

// ViewAny answers "view-any", which has no instance to act on.
func (p *{{.Name}}) ViewAny(user auth.Authenticatable) bool {
	return user != nil
}

// View answers "view".
func (p *{{.Name}}) View(user auth.Authenticatable, m *model) bool {
	return user != nil
}

// Create answers "create".
func (p *{{.Name}}) Create(user auth.Authenticatable) bool {
	return user != nil
}

// Update answers "update".
func (p *{{.Name}}) Update(user auth.Authenticatable, m *model) bool {
	return user != nil && m.OwnerID == user.GetAuthIdentifier()
}

// Delete answers "delete".
func (p *{{.Name}}) Delete(user auth.Authenticatable, m *model) bool {
	return user != nil && m.OwnerID == user.GetAuthIdentifier()
}
