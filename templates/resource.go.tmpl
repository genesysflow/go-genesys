package resources

// {{.Name}} shapes a model for a JSON response, so what a handler
// returns is decided here rather than by the model's own json tags:
//
//	return ctx.Resource(resources.New{{.Name}}(model))
type {{.Name}} struct {
	ID int64 `json:"id"`
}

// model is a placeholder: point the resource at your own model type.
type model struct{ ID int64 }

// New{{.Name}} maps the model onto the resource. Add a field here for
// every one the response should carry - and only those.
func New{{.Name}}(m *model) {{.Name}} {
	return {{.Name}}{ID: m.ID}
}
